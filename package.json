{
  "name": "docs-wired-club-habbo-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x",
    "yarn": "1.22.22"
  },
  "scripts": {
    "pm2:links:start": "PM2_HOME=.pm2 pm2 start ecosystem.config.cjs --only wired-club-links",
    "pm2:links:restart": "PM2_HOME=.pm2 pm2 restart wired-club-links --update-env",
    "pm2:links:logs": "PM2_HOME=.pm2 pm2 logs wired-club-links --lines 100",
    "pm2:links:status": "PM2_HOME=.pm2 pm2 describe wired-club-links",
    "pm2:links:stop": "PM2_HOME=.pm2 pm2 stop wired-club-links",
    "pm2:links:delete": "PM2_HOME=.pm2 pm2 delete wired-club-links",
    "watch:links": "node --env-file-if-exists=.env --import tsx src/watch-github-links.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "sync": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "dashboard": "node --env-file-if-exists=.env --import tsx src/dashboard.ts"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "octokit": "^5.0.5",
    "pm2": "^7.0.4",
    "wired-api-wrapper-node": "^1.0.6"
  }
}
