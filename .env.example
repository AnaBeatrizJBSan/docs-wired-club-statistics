# Required: BR, COM, DE, ES, FI, FR, IT, NL, S2, or TR
HABBO_HOTEL=
HABBO_ROOM_ID=
HABBO_WIRED_WRITE_KEY=
HABBO_WIRED_READ_KEY=

# Recommended for full syncs (especially reviews); required for private repos.
# Without a token, GitHub allows only 60 requests/hour per IP.
# A fine-grained token needs Pull requests: Read access to WiredClub/docs.
GITHUB_TOKEN=

# Delay between completed username-link checks (minimum 5 seconds).
GITHUB_LINK_POLL_SECONDS=15
